{
  "name": "capstone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "lint": "vue-cli-service lint",
    "heroku-prebuild": "npm install",
    "heroku-postbuild": "vue-cli-service build",
    "start": "npm run prod",
    "test": "cross-env NODE_ENV=test mocha -r ts-node/register/transpile-only 'server/api/test/**/*.test.js' --recursive --timeout 60000 --exit",
    "test-coverage": "cross-env NODE_ENV=test nyc mocha -r ts-node/register/transpile-only 'server/api/test/**/*.test.js' --recursive --timeout 60000 --exit",
    "dev": "cross-env NODE_ENV=development nodemon --require ts-node/register --inspect=9300 server/server.ts",
    "prod": "cross-env NODE_ENV=production node --require ts-node/register server/server.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@achrinza/node-ipc": "^10.1.11",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.0.8",
    "@vue/cli-service": "5.0.8",
    "apexcharts": "4.7.0",
    "aws-sdk": "2.1692.0",
    "axios": "1.10.0",
    "bcrypt": "6.0.0",
    "body-parser": "2.2.0",
    "chai": "5.2.0",
    "concurrently": "9.1.2",
    "connect-history-api-fallback": "2.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-session": "1.18.1",
    "generate-password": "1.7.1",
    "googleapis": "150.0.1",
    "js-convert-case": "4.2.0",
    "jsonwebtoken": "9.0.2",
    "mocha": "11.6.0",
    "moment": "^2.29.1",
    "multer": "2.0.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.1",
    "node-cron": "4.1.0",
    "nodemailer": "7.0.3",
    "resize-img": "^2.0.0",
    "sequelize": "^6.37.7",
    "uniqid": "5.4.0",
    "vue": "3.5.16",
    "vue-loader": "17.4.2",
    "vue-router": "4.5.1",
    "vue3-apexcharts": "1.8.0",
    "vuex": "4.1.0",
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.5",
    "@vue/cli-plugin-babel": "5.0.8",
    "@vue/cli-plugin-eslint": "5.0.8",
    "@vue/compiler-sfc": "3.5.16",
    "chromedriver": "^90.0.1",
    "eslint": "8.56.0",
    "eslint-plugin-vue": "9.19.2",
    "moment-duration-format": "^2.3.2",
    "nightwatch": "^1.6.4",
    "nyc": "^15.1.0",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
