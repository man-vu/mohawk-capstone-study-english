{
  "name": "react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ./src --quiet",
    "heroku-prebuild": "npm install",
    "heroku-postbuild": "vite build",
    "dev:server": "cross-env NODE_ENV=development nodemon --exec \"node --inspect=9300 --import ./loader-register.js --experimental-specifier-resolution=node\" server/server.ts",
    "prod:server": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require ts-node/register/transpile-only\" node server/server.ts",
    "test-coverage": "cross-env NODE_ENV=test nyc tsx ./node_modules/mocha/bin/mocha 'server/**/*.test.ts' --recursive --timeout 60000 --exit",
    "prisma:generate": "prisma generate",
    "test:back": "cross-env NODE_ENV=test tsx ./node_modules/mocha/bin/mocha 'server/**/*.test.ts' --recursive --timeout 60000 --exit",
    "test:front": "vitest run",
    "test": "npm run test:back && npm run test:front"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.0.2",
    "@prisma/client": "^5.13.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.47.12",
    "@types/prop-types": "^15.7.14",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-history-api-fallback": "^1.6.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.2",
    "express": "^5.1.0",
    "framer-motion": "^12.18.1",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.517.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.9.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.11",
    "nodemon": "^3.1.10",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0",
    "resize-img": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "^10.0.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.20",
    "chai": "^4.3.10",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^24.0.0",
    "mocha": "^10.4.0",
    "nyc": "^15.1.0",
    "postcss": "^8.4.45",
    "prisma": "^5.13.0",
    "sinon": "^21.0.0",
    "supertest": "^7.1.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.20.3",
    "vite": "^5.4.1",
    "vitest": "^1.4.0"
  }
}
