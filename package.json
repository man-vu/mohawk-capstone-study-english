{
  "name": "react-template",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ./src --quiet",
    "heroku-prebuild": "npm install",
    "heroku-postbuild": "vite build",
    "dev:server": "cross-env NODE_ENV=development NODE_OPTIONS=\"--require ts-node/register/transpile-only --inspect=9300\" nodemon --exec node server/server.ts",
    "prod:server": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require ts-node/register/transpile-only\" node server/server.ts",
    "test": "cross-env NODE_ENV=test mocha -r ts-node/register/transpile-only 'server/api/test/**/*.test.js' --recursive --timeout 60000 --exit",
    "test-coverage": "cross-env NODE_ENV=test nyc mocha -r ts-node/register/transpile-only 'server/api/test/**/*.test.js' --recursive --timeout 60000 --exit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.0.2",
    "@supabase/supabase-js": "^2.47.12",
    "@types/prop-types": "^15.7.14",
    "cross-env": "^7.0.3",
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "connect-history-api-fallback": "^1.6.0",
    "sequelize": "^6.37.1",
    "mysql2": "^3.9.6",
    "mysql": "^2.18.1",
    "aws-sdk": "^2.1582.0",
    "nodemailer": "^6.9.11",
    "bcrypt": "^5.1.1",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "resize-img": "^2.0.0",
    "dotenv": "^16.3.2",
    "@prisma/client": "^5.13.0",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1",
    "mocha": "^10.4.0",
    "chai": "^4.3.10",
    "nyc": "^15.1.0",
    "prisma": "^5.13.0"
  }
}
