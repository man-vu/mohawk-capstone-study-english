generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = "sqlserver://localhost:1433;database=QuizVerse;integratedSecurity=true;trustServerCertificate=true"
}

model AppLog {
  LogId      Int      @id(map: "PK__AppLog__5E5486487F853E48") @default(autoincrement())
