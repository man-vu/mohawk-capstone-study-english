generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = "sqlserver://localhost:1433;database=QuizVerse;integratedSecurity=true;trustServerCertificate=true"
}

model AppLog {
  LogId      Int      @id(map: "PK__AppLog__5E5486484AC737F0") @default(autoincrement())
  LogLevel   String   @db.NVarChar(20)
