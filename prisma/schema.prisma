  MockTest            MockTest[]
  Quiz                Quiz[]
  UserActivity        UserActivity[]
  UserAttempt         UserAttempt[]
  UserFavorite        UserFavorite[]
  UserLexiconProgress UserLexiconProgress[]
  UserRating          UserRating[]
}

